---
import { getCollection } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";

const heading = "My Projects";
// Show projects with the newest entries first.
const projects = (await getCollection("project")).slice().reverse();
---

<Layout title="Projects">
  <Section>
    <h1>{heading}</h1>
    {
      projects.map((project) => (
        <div class="card">
          <img src={project.data.image} alt={project.data.title} />
          <div>
            <h3>{project.data.title}</h3>
            <p class="description">{project.data.description}</p>
            <div class="button-container">
              <ButtonLink href={project.data.githubURL} text="View on Github" variant="secondary" />
              <ButtonLink href={project.data.liveURL} text="View Live" />
            </div>
          </div>
        </div>
      ))
    }
  </Section>
</Layout>

<style>
  h1 {
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .card {
    display: flex;
    gap: 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }

  .card:last-child {
    border-bottom: none;
  }

  h3 {
    font-size: clamp(22px, 2.5vw, 26px);
    font-weight: 500;
    margin-bottom: 16px;
    color: var(--text);
  }

  .description {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 20px;
    white-space: pre-line;
  }

  img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .button-container {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .card {
      flex-direction: column;
      gap: 24px;
    }

    img {
      width: 100%;
      max-width: 300px;
      height: 200px;
      align-self: flex-start;
    }
  }

  @media (max-width: 600px) {
    .card {
      padding: 32px 0;
    }

    .button-container {
      flex-direction: column;
    }
  }
</style>
