---
import Container from "./Container.astro";

const currentPath = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(path);
};
---

<nav class="nav">
  <Container>
    <div class="nav-container">
      <div>
        <a href="/"><img src="/images/logo111.svg" alt="logo" /></a>
      </div>
      <ul class="nav-items">
        <li><a href="/projects" class={isActive("/projects") ? "active" : ""}>Projects</a></li>
        <li><a href="/blog" class={isActive("/blog") ? "active" : ""}>Blog</a></li>
        <li><a href="/contact" class={isActive("/contact") ? "active" : ""}>Contact</a></li>
      </ul>
    </div>
  </Container>
</nav>

<style>
  .nav {
    background-color: transparent;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    z-index: 100;
    width: 100%;
  }

  .nav img {
    height: 33px;
    width: auto;
    opacity: 0.9;
    display: block;
    margin: 0;
    padding: 0;
  }

  .nav-container {
    display: flex;
    padding: 16px 0;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    min-height: 52px;
  }

  .nav-items {
    list-style-type: none;
    display: flex;
    gap: 32px;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    padding: 0;
  }

  .nav-items li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-container a {
    text-decoration: none;
    color: var(--text-secondary);
    font-weight: 400;
    transition: color 0.2s ease;
    position: relative;
    display: inline-block;
  }

  .nav-container a:hover {
    color: var(--text);
    opacity: 1;
  }

  .nav-container a.active {
    color: var(--text);
  }

  .nav-container a.active::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--text);
  }

  @media screen and (max-width: 600px) {
    .nav-container {
      flex-direction: column;
      gap: 8px;
      padding: 12px 0;
      min-height: auto;
    }

    .nav-items {
      gap: 20px;
      font-size: 13px;
    }

    .nav img {
      height: 28px;
    }
  }
</style>
