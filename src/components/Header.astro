---
import ButtonLink from "../components/ButtonLink.astro";
import Section from "../components/Section.astro";
---

<Section>
  <header id="header">
    <div class="content">
      <h1>
        <span class="greeting">Hi, I'm Mohamad</span><br />
        <span class="title">Developer & Enthusiast</span>
      </h1>
      <p class="description">
        Welcome to my portfolio. Here you'll find a showcase of my projects, skills, and creative work. 
        I enjoy designing and building modern, minimalistic, and high-performing digital experiences.
      </p>
      <div class="button-container">
        <ButtonLink href="/projects" text="View Projects" variant="secondary" />
      </div>
    </div>
    <div class="image-wrapper">
      <img src="/images/me.png" alt="Mohamad Badran" />
    </div>
  </header>
</Section>

<style>
  #header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
    padding: 40px 0;
  }

  .content {
    max-width: 600px;
  }

  .greeting {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: clamp(18px, 2vw, 20px);
  }

  .title {
    font-weight: 500;
    color: var(--text);
  }

  h1 {
    margin-bottom: 20px;
  }

  .description {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 24px;
    max-width: 540px;
  }

  .button-container {
    display: flex;
    gap: 12px;
  }

  .image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  img {
    width: 280px;
    height: 280px;
    object-fit: cover;
    border-radius: 50%;
    opacity: 0.95;
  }

  @media (max-width: 900px) {
    #header {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }

    .content {
      max-width: 100%;
    }

    .description {
      max-width: 100%;
    }

    .button-container {
      justify-content: center;
    }

    img {
      width: 240px;
      height: 240px;
    }
  }

  @media (max-width: 600px) {
    #header {
      padding: 40px 0;
      gap: 32px;
    }

    .button-container {
      flex-direction: column;
      align-items: center;
    }

    img {
      width: 200px;
      height: 200px;
    }
  }
</style>
