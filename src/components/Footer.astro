---
import Section from "./Section.astro";
---

<Section dark={true}>
  <footer>
    <div class="icons-container">
      <a href="mailto:mohamad@badran.io"><img src="/images/icons/email.svg" alt="email icon" /></a>
      <a href="https://github.com/bdrn" target="_blank"
        ><img src="/images/icons/github.svg" alt="github icon" /></a
      >
      <a href="https://linkedin.com/in/mohbadran" target="_blank"
        ><img src="/images/icons/linkedin.svg" alt="linkedin icon" /></a
      >
    </div>
    <p class="rights-text">© {new Date().getFullYear()} Mohamad Badran</p>
  </footer>
</Section>

<style>
  footer {
    display: flex;
    align-items: center;
    flex-direction: column;
    padding: 32px 0;
    border-top: 1px solid var(--border);
  }

  .icons-container {
    display: flex;
    gap: 24px;
    margin-bottom: 16px;
    align-items: center;
  }

  .icons-container a {
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .icons-container a:hover {
    opacity: 1;
  }

  .icons-container img {
    width: 20px;
    height: 20px;
    filter: grayscale(100%);
    transition: filter 0.2s ease;
  }

  .icons-container a:hover img {
    filter: grayscale(0%);
  }

  .rights-text {
    color: var(--text-tertiary);
    font-size: 13px;
    margin-bottom: 4px;
  }

  .credits-text {
    color: var(--text-tertiary);
    font-size: 12px;
  }

  @media screen and (max-width: 600px) {
    footer {
      padding: 40px 0;
    }

    .icons-container {
      gap: 20px;
    }
  }
</style>
