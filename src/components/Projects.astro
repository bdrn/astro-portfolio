---
import Section from "./Section.astro";
import { getCollection } from "astro:content";
// Only show the latest three projects on the homepage (newest at the top).
const projects = (await getCollection("project")).slice(-3).reverse();

import SectionHeader from "./SectionHeader.astro";
const heading = "My Projects";
const cta = { text: "View All", href: "/projects" };
---

<Section dark={true}>
  <SectionHeader cta={cta} heading={heading} />
  <div class="projects-container">
    {
      projects.map((project) => (
        <div class="project-card">
          <a href={project.data.liveURL} target="_blank">
            <img src={project.data.image} alt={project.data.title} />
          </a>
          <h3>
            <a href={project.data.liveURL}>{project.data.title}</a>
          </h3>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;

    .project-card {
      display: flex;
      flex-direction: column;
      transition: opacity 0.2s ease;
    }

    .project-card:hover {
      opacity: 0.8;
    }

    .project-card a {
      display: block;
    }

    .project-card a img {
      width: 100%;
      max-height: 200px;
      height: auto;
      object-fit: contain;
      border-radius: 2px;
      margin-bottom: 16px;
      transition: opacity 0.2s ease;
    }

    h3 {
      margin-top: 0;
      margin-bottom: 0;
      font-size: 18px;
      font-weight: 500;
      line-height: 1.4;
      text-align: center;
    }

    h3 a {
      color: var(--text);
      text-decoration: none;
    }

    @media (max-width: 900px) {
      & {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }
    }

    @media (max-width: 600px) {
      & {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .project-card a img {
        max-height: 180px;
      }
    }
  }
</style>
